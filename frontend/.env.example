AUTH_SECRET= # Added by `npx auth`. Read more: https://cli.authjs.dev

# Token para llamadas al backend API (usar en servidor; no usar NEXT_PUBLIC_ si no debe exponerse)
API_TOKEN=

# URL del backend solo en servidor (runtime). Login y API routes la usan en prod para no depender
# del valor incrustado en build de NEXT_PUBLIC_API_URL. Ej: https://api.digpatho.com/
API_URL=

# Contraseña del panel admin (solo servidor, NUNCA commitear valor real)
ADMIN_PASSWORD=

AUTH_GITHUB_SECRET= #HITHUB APPLICATION SECRET
AUTH_GITHUB_ID= #GITHUB APPLICATION DATA

AUTH_TRUST_HOST= #BOOLEAN

NEXTAUTH_URL= # The canonical URL of your site (e.g., https://app.digpatho.com or http://localhost:3000 for development)

# URL del FRONTEND (app) para redirects (logout, sesión expirada). Producción: https://app.digpatho.com
NEXT_PUBLIC_APP_URL=

# URL del BACKEND (API). El front llama a esta URL para todos los endpoints (users, informe, upload, etc.).
# Producción: https://api.digpatho.com  — NO usar la URL del app (app.digpatho.com) aquí.
# Preprod: https://api-preprod.digpatho.com/ — DEBE estar definida en el env de BUILD para que el bundle la use.
NEXT_PUBLIC_API_URL=

DB_PASS= #SUPABASE DATABASE PASSWORD

DIRECT_URL= #NEEDED FOR SUPABASE, DO NOT DELETE UNTIL CONFIRMATION OF CHANGES
SUPABASE_DATABASE_URL= #NEEDED FOR SUPABASE, DO NOT DELETE UNTIL CONFIRMATION OF CHANGES ITS NAME IS DATABASE URL BUT SINCE IT IS FROM DIFFERENT ORIGIN IN THE NORMAL ENV I DIFFERENTIATED THEM BY NAMING


DATABASE_URL= #New DATABASE URL GENERATED BY PRISMA ACCELERATE. ()
PRISMA_DB_API_KEY= #DATABASE APIKEY FOR URL. PRISMA PROVIDES THE URL WITH THE API KEY. BUT ALSO DE API KEY SEPARATED

GOOGLE_CLIENT_SECRET= #Generated in Google Oauth
GOOGLE_CLIENT_ID= #Given the same as the secret