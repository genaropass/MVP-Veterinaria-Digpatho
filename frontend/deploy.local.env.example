#
# Copiar a deploy.local.env y completar valores reales.
# deploy.local.env esta en .gitignore.
#

# prod | preprod
DEPLOY_TARGET="prod"

# direct = SSH al IP publico | iap = tunel gcloud (recomendado en Windows)
SSH_MODE="iap"

GCP_PROJECT="brave-dimension-480212-i8"
GCP_INSTANCE="backend-digpatho"
GCP_ZONE="us-east1-c"

HOST_FRONTEND="34.23.82.181"
SSH_USER="Agustin"
SSH_KEY="$HOME/.ssh/google_compute_engine"

# Produccion
REMOTE_NEW_DIR="/opt/digpatho/DigpathoWeb_new"
REMOTE_APP_DIR="/opt/digpatho/DigpathoWeb"
REMOTE_STAGING_DIR="/tmp/digpatho_web_new"
APP_NAME="digpatho-web"
APP_PORT="3000"
APP_OWNER="octavio_carranza_torres"
USE_ECOSYSTEM="true"

# Preproduccion (otra VM / usuario)
# DEPLOY_TARGET="preprod"
# REMOTE_APP_DIR="/home/agustind/DigpathoWeb_prepro"
# APP_NAME="digpatho-frontend-prepro"
# APP_PORT="3100"

HEALTHCHECK_URL="http://localhost:3000"
HEALTHCHECK_ATTEMPTS="12"
HEALTHCHECK_SLEEP_SECONDS="5"
DEFAULT_API_URL="https://api.digpatho.com/"
